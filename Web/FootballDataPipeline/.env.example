# PostgreSQL
POSTGRES_DB=football
POSTGRES_USER=football
POSTGRES_PASSWORD=replace_me_postgres
POSTGRES_PORT=5433

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_USER=football
RABBITMQ_PASSWORD=replace_me_rabbitmq
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

# API-Football
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=replace_me_api_football
API_FOOTBALL_TIMEOUT_SECONDS=10

# Periodic synchronization
SYNC_LEAGUE_ID=39
SYNC_SEASON=2024
FIXTURE_SYNC_INTERVAL_SECONDS=21600
STANDING_SYNC_INTERVAL_SECONDS=21600

# Live polling
LIVE_FIXTURE_SYNC_ENABLED=false
LIVE_FIXTURE_SYNC_INTERVAL_SECONDS=30
